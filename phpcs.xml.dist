```xml
<?xml version="1.0"?>
<ruleset name="Dizzy Events Manager">

    <description>
        Coding standard for Dizzy Events Manager.
    </description>

    <arg name="basepath" value="."/>

    <arg name="colors"/>

    <arg value="sp"/>

    <file>includes</file>
    <file>assets</file>
    <file>dizzy-events-manager.php</file>

    <exclude-pattern>vendor/*</exclude-pattern>

    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>

    <config name="minimum_supported_wp_version" value="6.5"/>

</ruleset>
```

